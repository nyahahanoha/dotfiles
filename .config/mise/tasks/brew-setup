#!/usr/bin/env bash
#MISE description="Install Homebrew packages defined in Brewfiles and remove packages not listed in it."
set -euo pipefail

brew_dir="$HOME/.brew"
files=(
  "Brewfile.core"
  "Brewfile.gui"
  "Brewfile.extra"
)

tmp_brewfile="$(mktemp)"
cleanup_output="$(mktemp)"
trap 'rm -f "$tmp_brewfile" "$cleanup_output"' EXIT

for f in "${files[@]}"; do
  cat "$brew_dir/$f" >> "$tmp_brewfile"
  printf '\n' >> "$tmp_brewfile"
done

echo "==> brew bundle install --file=$tmp_brewfile"
brew bundle install --file="$tmp_brewfile" 2>&1

echo "==> brew bundle cleanup --file=$tmp_brewfile"
set +e
brew bundle cleanup --file="$tmp_brewfile" > "$cleanup_output" 2>&1
cleanup_status="$?"
set -e

if [ "$cleanup_status" -eq 0 ]; then
  exit 0
fi

if ! grep -q 'brew bundle cleanup --force' "$cleanup_output"; then
  cat "$cleanup_output"
  exit "$cleanup_status"
fi

echo "Cleanup targets:"
awk '
  /^Would (uninstall|untap)/ || /^Would `brew cleanup`:/ {
    printing = 1
    print
    next
  }
  /^Run `brew bundle cleanup --force`/ {
    printing = 0
    next
  }
  printing && NF {
    print
  }
' "$cleanup_output"

printf 'Remove these packages? [y/N] '
if ! read -r answer; then
  answer=""
fi

case "$answer" in
  [yY] | [yY][eE][sS])
    echo "==> brew bundle cleanup --force"
    brew bundle cleanup --force --file="$tmp_brewfile"
    ;;
  *)
    echo "Skipped Homebrew cleanup."
    ;;
esac
